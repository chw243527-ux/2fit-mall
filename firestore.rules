rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════
    // 헬퍼 함수
    // ════════════════════════════════════════════════════════

    // 로그인 여부
    function isSignedIn() {
      return request.auth != null;
    }

    // 본인 문서 여부
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // 관리자 여부 (Custom Claims 우선, 없으면 Firestore users 문서 확인)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('isAdmin', false) == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
      );
    }

    // 관리자 FCM 토큰 필드 검증
    function isValidAdminToken(data) {
      return data.keys().hasAll(['token'])
          && data.token is string
          && data.token.size() > 10
          && data.token.size() <= 4096
          && (!('platform' in data) || data.platform in ['web', 'android', 'ios']);
    }

    // 이메일 인증 완료 여부
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    // 요청 데이터 크기 제한 (4KB 이하)
    function isReasonableSize() {
      return request.resource.data.size() < 50;
    }

    // 문자열 길이 검증
    function validStr(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    // 양수 숫자 검증
    function isPositiveNumber(val) {
      return val is number && val > 0;
    }

    // 주문 금액 합리성 검증 (1원 이상 ~ 50,000,000원 이하)
    function isValidOrderAmount(amount) {
      return isPositiveNumber(amount) && amount <= 50000000;
    }

    // 사용자 필드 검증
    function isValidUserData(data) {
      return validStr(data.name, 50)
          && validStr(data.email, 100)
          && (!('phone' in data) || validStr(data.phone, 20))
          && (!('grade' in data) || data.grade in ['bronze','silver','gold','vip'])
          && (!('isAdmin' in data) || data.isAdmin == false); // 본인이 isAdmin 설정 불가
    }

    // 리뷰 필드 검증
    function isValidReview(data) {
      return validStr(data.content, 1000)
          && data.rating is number
          && data.rating >= 1
          && data.rating <= 5;
    }

    // 채팅 메시지 필드 검증
    function isValidMessage(data) {
      return validStr(data.text, 2000);
    }


    // ════════════════════════════════════════════════════════
    // users 컬렉션
    // ════════════════════════════════════════════════════════
    match /users/{userId} {
      // 읽기: 본인 또는 관리자
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());

      // 생성: 본인 계정만, isAdmin=false 강제, 필드 검증
      allow create: if isSignedIn()
          && isOwner(userId)
          && isValidUserData(request.resource.data)
          && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
          && (!('points' in request.resource.data) || request.resource.data.points == 0); // 포인트 임의 설정 금지

      // 수정: 본인(제한 필드만) 또는 관리자
      allow update: if isSignedIn() && (
        (isOwner(userId)
          && !('isAdmin' in request.resource.data.diff(resource.data).affectedKeys()) // isAdmin 변경 금지
          && !('points' in request.resource.data.diff(resource.data).affectedKeys())  // 포인트 직접 변경 금지
        ) || isAdmin()
      );

      // 삭제: 관리자만
      allow delete: if isAdmin();

      // point_history 서브컬렉션 (포인트 적립/사용 내역)
      match /point_history/{historyId} {
        allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
        // 포인트 이력은 클라이언트가 위조할 수 없도록 서버/관리자만 생성
        allow create: if isAdmin();
        allow update, delete: if isAdmin();
      }
    }


    // ════════════════════════════════════════════════════════
    // products 컬렉션
    // ════════════════════════════════════════════════════════
    match /products/{productId} {
      allow read: if true;          // 누구나 상품 조회
      allow write: if isAdmin();    // 관리자만 수정/삭제

      // stockLogs 서브컬렉션 (재고 이력)
      // inventory_logs 대신 products/{id}/stockLogs 에 저장
      match /stockLogs/{logId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }


    // ════════════════════════════════════════════════════════
    // orders 컬렉션
    // ════════════════════════════════════════════════════════
    match /orders/{orderId} {
      // 읽기: 본인 주문 또는 관리자
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // 주문 생성은 서버 결제 함수만 수행합니다. Firebase Admin SDK는 규칙을 우회합니다.
      // 클라이언트가 상품 가격·할인·상태를 위조한 주문을 직접 만들 수 없습니다.
      allow create: if isAdmin();

      // 수정: 본인(상태 변경 제한) 또는 관리자
      allow update: if isSignedIn() && (
        (
          resource.data.userId == request.auth.uid
          // 고객은 status를 'cancelled'로만 변경 가능 (pending 또는 confirmed 상태에서)
          && (
            !('status' in request.resource.data.diff(resource.data).affectedKeys())
            || (
              request.resource.data.status == 'cancelled'
              && (resource.data.status == 'pending' || resource.data.status == 'confirmed')
            )
          )
          // 고객은 totalAmount 변경 불가
          && !('totalAmount' in request.resource.data.diff(resource.data).affectedKeys())
        ) || isAdmin()
      );

      // 삭제: 관리자만
      allow delete: if isAdmin();
    }


    // ════════════════════════════════════════════════════════
    // reviews 컬렉션
    // ════════════════════════════════════════════════════════
    match /reviews/{reviewId} {
      allow read: if true;  // 누구나 리뷰 조회

      // 생성: 로그인 + 본인 userId + 내용 검증
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && isValidReview(request.resource.data);

      // 고객은 본인 리뷰의 원문 필드만 수정하고, 베스트·관리자 답변은 관리자만 변경
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && isValidReview(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'content', 'images', 'size', 'color', 'updatedAt'
        ])
      );

      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }


    // ════════════════════════════════════════════════════════
    // coupons 컬렉션
    // ════════════════════════════════════════════════════════
    match /coupons/{couponId} {
      allow read: if isSignedIn();   // 로그인 사용자만 쿠폰 조회
      allow write: if isAdmin();     // 발급/수정/삭제는 관리자만
    }


    // ════════════════════════════════════════════════════════
    // notifications 컬렉션
    // ════════════════════════════════════════════════════════
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin();
      // 읽음 처리(isRead 필드만 수정 허용)
      allow update: if isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      allow delete: if isAdmin();
    }


    // ════════════════════════════════════════════════════════
    // notices 컬렉션 (공지사항/팝업)
    // ════════════════════════════════════════════════════════
    match /notices/{noticeId} {
      allow read: if true;           // 누구나 공지 조회
      allow write: if isAdmin();     // 관리자만 작성/수정/삭제
    }


    // ════════════════════════════════════════════════════════
    // chats 컬렉션
    // ════════════════════════════════════════════════════════
    match /chats/{chatId} {
      // 본인 채팅방만 읽기/쓰기 (또는 관리자)
      allow read: if isSignedIn() && (
        request.auth.uid == chatId || isAdmin()
      );
      // 채팅방 문서 생성/수정: 본인만
      allow create, update: if isSignedIn() && (
        request.auth.uid == chatId || isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isSignedIn() && (
          request.auth.uid == chatId || isAdmin()
        );
        // 메시지 생성: 로그인 + 내용 길이 검증
        allow create: if isSignedIn()
            && (request.auth.uid == chatId || isAdmin())
            && ('text' in request.resource.data
                ? isValidMessage(request.resource.data)
                : true);
        allow update, delete: if isAdmin();
      }
    }


    // ════════════════════════════════════════════════════════
    // chat_rooms 컬렉션 (채팅방 메타데이터)
    // ════════════════════════════════════════════════════════
    match /chat_rooms/{roomId} {
      // 본인 채팅방 또는 관리자
      allow read: if isSignedIn() && (
        request.auth.uid == roomId || isAdmin()
      );
      allow create, update: if isSignedIn() && (
        request.auth.uid == roomId || isAdmin()
      );
      allow delete: if isAdmin();
    }


    // ════════════════════════════════════════════════════════
    // fcmTokens 컬렉션
    // ════════════════════════════════════════════════════════
    match /fcmTokens/{tokenId} {
      // 본인 토큰만 읽기/쓰기
      allow read, write: if isSignedIn() && isOwner(tokenId);
    }


    // ════════════════════════════════════════════════════════
    // admin_fcm_tokens 컬렉션 (관리자 FCM 토큰 — Cloud Functions용)
    // ════════════════════════════════════════════════════════
    match /admin_fcm_tokens/{tokenId} {
      // 관리자 기기에서만 토큰 생성·갱신 가능
      allow create, update: if isAdmin() && isValidAdminToken(request.resource.data);
      // 읽기/삭제는 관리자만
      allow read, delete: if isAdmin();
    }


    // ════════════════════════════════════════════════════════
    // categories 컬렉션 (카테고리 캐시)
    // ════════════════════════════════════════════════════════
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ════════════════════════════════════════════════════════
    // app_settings 컬렉션 (앱 전역 설정 — 카테고리, 섹션 등)
    // ════════════════════════════════════════════════════════
    match /app_settings/{docId} {
      allow read: if true;        // 누구나 읽기 (카테고리 목록 조회)
      allow write: if isAdmin();  // 관리자만 쓰기
    }


    // ════════════════════════════════════════════════════════
    // banners 컬렉션
    // ════════════════════════════════════════════════════════
    match /banners/{bannerId} {
      allow read: if true;        // 누구나 배너 조회
      allow write: if isAdmin();  // 관리자만 수정/삭제
    }


    // ════════════════════════════════════════════════════════
    // exchange_requests 컬렉션 (교환/반품 요청)
    // ════════════════════════════════════════════════════════
    match /exchange_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }


    // ════════════════════════════════════════════════════════
    // design_requests 컬렉션 (디자인 수정 요청)
    // ════════════════════════════════════════════════════════
    match /design_requests/{reqId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }


    // ════════════════════════════════════════════════════════
    // inventory 컬렉션 (재고 현황)
    // ════════════════════════════════════════════════════════
    match /inventory/{productId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }


    // ════════════════════════════════════════════════════════
    // inventory_logs 컬렉션 (재고 이력)
    // ════════════════════════════════════════════════════════
    match /inventory_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }


    // ════════════════════════════════════════════════════════
    // admin_coupons 컬렉션 (관리자가 발행한 쿠폰)
    // ════════════════════════════════════════════════════════
    match /admin_coupons/{couponId} {
      allow read: if true;           // 누구나 조회 가능 (다운로드 팝업 비로그인 표시)
      // 발급·수정·삭제는 관리자만. 다운로드 트랜잭션의 카운트 1 증가만 예외 허용
      allow update: if isAdmin() || (
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
        && request.resource.data.downloadCount == resource.data.get('downloadCount', 0) + 1
      );
      allow create, delete: if isAdmin();
    }


    // ════════════════════════════════════════════════════════
    // user_coupons 컬렉션 (사용자가 다운로드한 쿠폰)
    // ════════════════════════════════════════════════════════
    match /user_coupons/{userId} {
      // 본인 또는 관리자만 최상위 문서 읽기
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isAdmin();

      match /coupons/{couponId} {
        // 본인 쿠폰 읽기: 본인 또는 관리자
        allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
        // 쿠폰 발급·예약·사용 처리는 서버 결제 함수에서만 수행합니다.
        // Firebase Admin SDK는 규칙을 우회하며, 관리자는 운영 목적상 접근할 수 있습니다.
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }
    }


    // 관리자 알림: 관리자만 읽기·쓰기
    match /admin_notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    // 전체/등급별 프로모션 알림: 관리자만 생성·관리
    match /broadcast_notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    // 재입고 알림 신청: 신청자 본인 또는 관리자만 접근
    match /restock_alerts/{alertId} {
      allow read: if isSignedIn()
          && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.productId.size() <= 200;
      allow update, delete: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 이메일 큐: 인증 사용자만 큐 등록, 처리는 서버/관리자만
    match /email_queue/{queueId} {
      allow create: if isSignedIn()
          && request.resource.data.templateId is string
          && request.resource.data.templateId.size() > 0
          && request.resource.data.templateId.size() <= 100
          && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // 개인정보 열람·삭제 요청: 본인 신청·열람, 관리자 처리
    match /privacy_requests/{requestId} {
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.requestType in ['view', 'delete', 'export'];
      allow read: if isSignedIn()
          && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 접근 로그·동의 이력은 위변조 방지를 위해 생성 후 변경 금지
    match /access_logs/{logId} {
      allow create: if isAdmin()
          && request.resource.data.adminId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /consent_history/{historyId} {
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.agreed is bool
          && request.resource.data.version is string;
      allow read: if isSignedIn()
          && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // 사이즈 프로필은 사용자별 하위 컬렉션으로 격리
    match /size_profiles/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isAdmin();

      match /profiles/{profileId} {
        allow read, write: if isSignedIn() && (isOwner(userId) || isAdmin());
      }
    }

    // ════════════════════════════════════════════════════════
    // 그 외 모든 컬렉션: 기본 차단
    // ════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
