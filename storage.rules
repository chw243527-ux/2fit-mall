rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // 역할 권한은 서버에서만 관리하는 Auth custom claim을 사용합니다.
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isReasonableUpload() {
      return request.resource != null
          && request.resource.size <= 10 * 1024 * 1024
          && request.resource.contentType in [
            'image/jpeg', 'image/png', 'image/webp', 'image/gif',
            'image/svg+xml', 'application/pdf', 'application/postscript'
          ];
    }

    // 주문 문서가 아직 생성되지 않은 업로드 단계는 허용하되,
    // 주문이 확정·제작·배송·취소된 뒤에는 고객의 파일 변경을 차단합니다.
    function isCustomerOrderFileEditable(orderId) {
      let orderPath = /databases/(default)/documents/orders/$(orderId);
      return !firestore.exists(orderPath)
          || firestore.get(orderPath).data.status in ['pending', 'awaiting_deposit'];
    }

    // 상품 이미지·배너·공지사항: 공개 읽기, 관리자만 업로드·수정·삭제
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isReasonableUpload();
      allow delete: if isAdmin();
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isReasonableUpload();
      allow delete: if isAdmin();
    }

    match /notices/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isReasonableUpload();
      allow delete: if isAdmin();
    }

    // 일반 주문 첨부파일: 주문 문서의 userId와 로그인 사용자를 비교
    match /orders/{orderId}/{allPaths=**} {
      allow read: if isAdmin()
          || (isSignedIn()
              && firestore.get(/databases/(default)/documents/orders/$(orderId)).data.userId == request.auth.uid);
      allow create, update: if isReasonableUpload()
          && (isAdmin()
              || (isSignedIn()
                  && isCustomerOrderFileEditable(orderId)
                  && firestore.get(/databases/(default)/documents/orders/$(orderId)).data.userId == request.auth.uid));
      allow delete: if isAdmin()
          || (isSignedIn()
              && isCustomerOrderFileEditable(orderId)
              && firestore.get(/databases/(default)/documents/orders/$(orderId)).data.userId == request.auth.uid);
    }

    // 신규 단체주문 첨부파일: group_orders/{userId}/{orderId}/... 구조만 허용
    match /group_orders/{userId}/{orderId}/{allPaths=**} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isReasonableUpload()
          && (isAdmin()
              || (isSignedIn()
                  && request.auth.uid == userId
                  && isCustomerOrderFileEditable(orderId)));
      allow delete: if isAdmin()
          || (isSignedIn()
              && request.auth.uid == userId
              && isCustomerOrderFileEditable(orderId));
    }

    // 기존 userId 없는 단체주문 경로는 소유권 확인이 불가능하므로 차단
    match /group_orders/{allPaths=**} {
      allow read, write: if false;
    }

    // 신규 교환·반품 첨부파일: exchange_requests/{userId}/{requestId}/... 구조
    match /exchange_requests/{userId}/{requestId}/{allPaths=**} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isReasonableUpload()
          && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // 채팅 첨부파일은 roomId가 사용자 ID인 경우에만 본인 접근 허용.
    // 관리자 채팅 화면은 관리자 권한으로 접근합니다.
    match /chats/{roomId}/{allPaths=**} {
      allow read: if isAdmin()
          || (isSignedIn() && request.auth.uid == roomId);
      allow create, update: if isReasonableUpload()
          && (isAdmin() || (isSignedIn() && request.auth.uid == roomId));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == roomId);
    }

    // 사용자 프로필 이미지: 개인정보 보호를 위해 본인·관리자만 읽기
    match /users/{userId}/{allPaths=**} {
      allow read: if isAdmin()
          || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && isReasonableUpload();
      allow delete: if isAdmin()
          || (isSignedIn() && request.auth.uid == userId);
    }
  }
}
